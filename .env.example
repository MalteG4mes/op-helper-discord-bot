# Niemals den echten Token weitergeben oder in Git einchecken.
DISCORD_TOKEN=dein_bot_token
CLIENT_ID=deine_application_id
GUILD_ID=deine_test_server_id

# Kanal-IDs (Rechtsklick auf Kanal > ID kopieren; Entwicklermodus aktivieren)
WELCOME_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# Kommagetrennte Liste. Der Bot ignoriert Groß-/Kleinschreibung.
BANNED_TERMS=beispielwort,spam-link.example

# delete | timeout | ban. "ban" nur nutzen, wenn das wirklich eure Serverregel ist.
FILTER_ACTION=timeout
FILTER_TIMEOUT_MINUTES=60
